# Contoh konfigurasi. Salin ke .env lalu sesuaikan, atau pakai argumen run.py.
# Argumen CLI menimpa nilai di sini.
#
# .env TIDAK dibaca otomatis — muat dengan:  set -a; . ./.env; set +a

# Berkas akun. Dibuat lewat:  python run.py --adduser <nama>
LABELAPP_USERS_FILE=./users.json

# Folder induk dataset. Subfolder di dalamnya muncul sebagai daftar pilihan.
LABELAPP_DATASETS_ROOT=/home/paul/computer-vision/datasets

# Tempat unggahan dari browser, dipisah per akun.
# Default: <DATASETS_ROOT>/_unggahan
#LABELAPP_UPLOADS_ROOT=/home/paul/labelapp-unggahan

# Folder yang langsung dibuka setiap akun saat masuk. Kosongkan agar tiap
# akun memilih sendiri.
#LABELAPP_DEFAULT_SRC=

# Batas ukuran per berkas unggahan, dalam MB.
LABELAPP_MAX_UPLOAD_MB=80
# Batas terpisah untuk berkas .zip, karena satu ekspor Roboflow bisa lebih
# dari 1 GB sementara batas per-gambar sengaja tetap kecil.
LABELAPP_MAX_ZIP_MB=4096

# Perintah AnyLabeling, dipakai tombol "Perbaiki" (hanya dari mesin server).
LABELAPP_ANYLABELING=anylabeling

# file = buka tepat berkas yang diklik. dir = buka seluruh folder.
LABELAPP_OPEN_MODE=file

# Daftar kelas tambahan yang belum pernah dipakai di dataset, satu per baris.
#LABELAPP_LABELS_FILE=./kelas.txt

# Tolak label di luar daftar. Aktifkan setelah taksonomi kelas final.
LABELAPP_LOCK_LABELS=0

# Cache thumbnail. Default: /tmp/labelapp_<pid>, dihapus saat proses berhenti.
#LABELAPP_THUMB_ROOT=
