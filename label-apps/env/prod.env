# Setelan PRODUKSI — dipakai tim.
#
# Dibaca oleh start.sh: `./start.sh prod`
# Berkas ini tidak memuat rahasia, hanya path dan angka. Yang rahasia ada di
# users.json (izin 600, tidak masuk repo).

LABELAPP_PORT=8042

# Nama yang dipakai aplikasi menyebut dirinya. Dev memakai "HIGOLAB-DEV"
# supaya kedua tab bisa dibedakan sekilas.
LABELAPP_NAMA=HIGOLAB

# 127.0.0.1 kalau di belakang nginx (lihat deploy/README.md).
# 0.0.0.0 kalau diakses langsung lewat IP:port tanpa proxy.
LABELAPP_HOST=0.0.0.0

LABELAPP_USERS_FILE=users.json
LABELAPP_DATASETS_ROOT=/home/paul/computer-vision/datasets
LABELAPP_UPLOADS_ROOT=/home/paul/computer-vision/datasets/_unggahan

LABELAPP_MAX_UPLOAD_MB=80
LABELAPP_MAX_ZIP_MB=4096
LABELAPP_OPEN_MODE=file
LABELAPP_LOCK_LABELS=0

# Domain Google Workspace yang boleh masuk sendiri lewat login Google,
# mis. "higo.id". Kosong berarti login Google MATI.
#
# Menyalakannya butuh tiga hal lebih dulu, dan Google menolak alamat IP
# sebagai tujuan pengalihan:
#   1. DNS anylabel.higo.id menunjuk ke server ini
#   2. nginx berjalan dengan sertifikat TLS
#   3. OAuth client terdaftar di Google Cloud
#
# Email di LUAR domain ini tetap bisa masuk, tapi hanya kalau sudah
# didaftarkan admin lewat halaman /akun.
LABELAPP_GOOGLE_DOMAIN=

# Boleh mendaftar sendiri lewat /daftar. 1 = boleh (bawaan).
LABELAPP_DAFTAR_SENDIRI=1

# 1 = akun hasil pendaftaran LANGSUNG bisa masuk, tanpa menunggu persetujuan
# admin. Hanya pantas dinyalakan kalau firewall membatasi siapa yang bisa
# menjangkau port ini. Periksa dulu:
#
#   sudo ufw status verbose | head -5     -> harus "Default: deny (incoming)"
#   sudo ufw status | grep 8042           -> harus dibatasi ke IP tertentu
#
# Ingat juga Tailscale: aturannya sendiri berada di atas ufw, jadi perangkat
# di tailnet tetap bisa menjangkau aplikasi ini.
#
# DIMATIKAN 9 September 2026 sesudah audit keamanan. Alasannya, dan kenapa
# aman dimatikan sekarang:
#
#   Menyalakannya membuang satu-satunya hal yang menggantikan verifikasi
#   email di aplikasi ini. security.py:172 menyebutnya sendiri: "supaya aman
#   kalau ternyata portnya terbuka ke luar jaringan kantor -- pendaftaran
#   liar berakhir sebagai daftar tunggu, bukan sebagai akses." Dengan nilai
#   1, siapa pun yang bisa menjangkau port 8042 langsung dapat akses penuh
#   ke 12.292 gambar tanpa satu pun orang menyetujuinya.
#
#   Tidak ada yang terkunci karenanya: prod sudah punya dua akun aktif
#   (darma dan aditya, keduanya admin), dan setelan ini hanya berlaku untuk
#   pendaftar BARU. Diuji: admin lama tetap masuk, pendaftar baru ditahan,
#   admin melihatnya di daftar tunggu /akun, menyetujuinya, lalu ia bisa
#   masuk.
#
#   HATI-HATI pada instalasi BARU: dengan nilai 0, akun pertama pun ikut
#   menunggu, dan tidak ada admin yang bisa menyetujuinya -- kebuntuan.
#   Untuk instalasi baru, nyalakan dulu (1), buat akun admin pertama,
#   restart supaya ia diangkat admin, lalu matikan lagi.
LABELAPP_DAFTAR_LANGSUNG=0
