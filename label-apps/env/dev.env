# Setelan PENGEMBANGAN — untuk ngoding, tidak untuk tim.
#
# Dibaca oleh start.sh: `./start.sh dev`
#
# Semua path SENGAJA berbeda dari prod: akun, dataset, dan unggahan terpisah.
# Dengan begitu mencoba-coba di dev tidak bisa merusak anotasi tim, dan akun uji
# tidak bisa dipakai masuk ke prod. Port juga berbeda supaya keduanya bisa
# hidup bersamaan. Daftar lengkap yang dipisah ada di tests/test_mode.py, yang
# gagal kalau salah satunya sampai sama.
LABELAPP_PORT=8043

# 0.0.0.0, sama seperti prod, supaya dev bisa dibuka dari laptop di jaringan
# HIGO — bukan hanya dari layar server ini.
#
# Yang menjaganya tetap aman bukan alamat ikatan ini, melainkan dua hal lain:
#   1. ufw hanya mengizinkan port 8043 dari IP kantor (sama seperti 8042);
#   2. LABELAPP_DEV_AUTOLOGIN di bawah hanya berlaku dari mesin ini sendiri,
#      jadi siapa pun yang datang lewat jaringan TETAP harus login.
LABELAPP_HOST=0.0.0.0

LABELAPP_USERS_FILE=users.dev.json
LABELAPP_DATASETS_ROOT=./dev-data/datasets
LABELAPP_UPLOADS_ROOT=./dev-data/unggahan
LABELAPP_THUMB_ROOT=./dev-data/thumb

# Disamakan dengan prod. Dev dipakai sebagai SIMULASI: batas yang lebih kecil
# membuat unggahan yang lolos di dev ditolak di prod, atau sebaliknya, dan
# kegagalan seperti itu baru ketahuan setelah tim yang mengalaminya.
LABELAPP_MAX_UPLOAD_MB=80
LABELAPP_MAX_ZIP_MB=4096
LABELAPP_OPEN_MODE=file
LABELAPP_LOCK_LABELS=0

# Disamakan dengan prod supaya alur pendaftaran yang diuji di sini berperilaku
# persis seperti nanti di produksi. Kalau dibiarkan kosong, bawaannya berbeda:
# DAFTAR_LANGSUNG mati, sehingga akun baru di dev menggantung menunggu
# persetujuan padahal di prod tidak.
LABELAPP_GOOGLE_DOMAIN=
LABELAPP_DAFTAR_SENDIRI=1
LABELAPP_DAFTAR_LANGSUNG=1

# Masuk otomatis sebagai akun ini, tanpa password — supaya --reload tidak
# memaksa login ulang setiap kali kode disentuh.
#
# Hanya berlaku untuk permintaan dari mesin ini sendiri (deps.sesi_otomatis
# memakai is_local, dan permintaan lewat proxy pun ditolak). Karena itu ia
# tetap aman walau HOST di atas 0.0.0.0: dari laptop, halaman login tetap
# muncul. Kosongkan kalau ingin menguji alur login-nya dari mesin ini juga.
LABELAPP_DEV_AUTOLOGIN=devuser
