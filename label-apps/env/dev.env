# Setelan PENGEMBANGAN — untuk ngoding, tidak untuk tim.
#
# Dibaca oleh start.sh: `./start.sh dev`
#
# Semua path SENGAJA berbeda dari prod: akun, dataset, dan unggahan terpisah.
# Dengan begitu mencoba-coba di dev tidak bisa merusak anotasi tim, dan akun uji
# tidak bisa dipakai masuk ke prod. Port juga berbeda supaya keduanya bisa
# hidup bersamaan.

LABELAPP_PORT=8043
LABELAPP_HOST=127.0.0.1

LABELAPP_USERS_FILE=users.dev.json
LABELAPP_DATASETS_ROOT=./dev-data/datasets
LABELAPP_UPLOADS_ROOT=./dev-data/unggahan
LABELAPP_THUMB_ROOT=./dev-data/thumb

LABELAPP_MAX_UPLOAD_MB=20
LABELAPP_OPEN_MODE=file
LABELAPP_LOCK_LABELS=0
