# Salin jadi env/rahasia.env lalu isi. Berkas rahasia.env TIDAK ikut git.
#
# Didapat dari Google Cloud Console -> APIs & Services -> Credentials,
# setelah membuat "OAuth client ID" bertipe "Web application".
LABELAPP_GOOGLE_CLIENT_ID=
LABELAPP_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- surel
# Pengirim undangan. Tanpa ini, undangan tetap dibuat tetapi tautannya harus
# disalin sendiri; sistem tidak pernah mencoba mengirim dan tidak pernah gagal
# diam-diam.
#
# Jalur keluar dari mesin ini sudah terbuka (smtp.gmail.com:587 dan :465),
# jadi tidak perlu memasang server surel apa pun.
#
# App password 16 karakter, dibuat di akun Google-nya sendiri. JANGAN taruh di
# env/prod.env: berkas itu ikut ke git.
#LABELAPP_SMTP_HOST=smtp.gmail.com
#LABELAPP_SMTP_PORT=587
#LABELAPP_SMTP_USER=no-reply@higo.id
#LABELAPP_SMTP_PASS=xxxxxxxxxxxxxxxx
#LABELAPP_SMTP_DARI=Labeling Tools <no-reply@higo.id>
