# Kredensial — jangan pernah masuk repo
users.json
.env

# Virtualenv (312 MB, dibuat ulang dari requirements.txt)
.venv/
venv/
# Virtualenv jalur GPU — 6 GB, isinya pustaka CUDA. Dibuat ulang dari
# requirements.txt + requirements-gpu.txt; lihat start.sh.
.venv-gpu/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Data: dataset dan unggahan tidak ikut ke repo
_unggahan/
unggahan/
labelapp-unggahan/
*.jpg
*.jpeg
*.png
!app/static/icons/*.png
# Pelat latar ruang RVM yang DIBUNDEL bersama aplikasi — aset kode, bukan data
# pemakai. Aturan *.png di atas menelannya diam-diam, dan akibatnya baru
# terlihat di checkout yang lain: augmentasi di sana kehilangan seluruh pelat
# bawaannya tanpa satu pun pesan, karena olah.muat_pelat() hanya mengembalikan
# daftar kosong. Terjadi sungguhan — deploy prod pertama gagal di
# tests/test_latar.py dengan "pelat bawaan harus ikut terbundel".
!app/data/latar-rvm/*.png
*.bmp
*.webp
*.tif
*.tiff

# Editor & OS
.vscode/
.idea/
.DS_Store
*.swp

# Akun & data mode dev (terpisah dari prod)
users.dev.json
dev-data/

# Log dan catatan runtime (dibuat deploy.sh)
logs/
run/
laporan/*.xlsx
